@using CRManager.Shared.DTOs
@using CRManager.Shared.Components

<div class="space-y-4 animate-fade-in" dir="rtl">
    <!-- Top Back Navigation & Primary Action Bar -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 border-b border-slate-800">
        <div class="flex items-center gap-3">
            <button @onclick="OnBack" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-xl border border-slate-700/80 transition-all flex items-center gap-1.5 shadow-sm">
                <span>←</span> العودة إلى المحفظة
            </button>
            <div class="flex items-center gap-2.5">
                <BankBadge BankName="@Card.BankName" Size="md" />
                <div class="text-right">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-lg sm:text-xl font-bold text-slate-100">
                            @Card.BankName
                        </h2>
                        @if (!string.IsNullOrEmpty(ArabicBankName) && !string.Equals(ArabicBankName, Card.BankName, StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="text-[10px] sm:text-xs font-bold text-indigo-200 bg-indigo-950/90 border border-indigo-500/40 px-2 py-0.5 rounded-md shadow-sm whitespace-nowrap">
                                @ArabicBankName
                            </span>
                        }
                        <span class="text-xs font-normal text-slate-400">| سجل المعاملات</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2 self-stretch sm:self-auto justify-end">
            <button @onclick="() => OnEditCard.InvokeAsync(Card)" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-amber-300 hover:text-amber-200 border border-slate-700/80 text-xs font-semibold rounded-xl shadow transition-all flex items-center gap-1.5">
                <span>✏️</span> تعديل البطاقة
            </button>
            <button @onclick="() => OnAddTransaction.InvokeAsync(Card.Id)" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl shadow-lg transition-all flex items-center gap-1.5 justify-center">
                <span>➕</span> تسجيل معاملة للبطاقة
            </button>
        </div>
    </div>

    <!-- 4-Stat Balanced Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
        <!-- 1. Credit Limit -->
        <div class="glass-card p-3 rounded-xl border border-slate-800/90 bg-slate-900/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-400 text-[10px] uppercase font-semibold">
                <span>حد الائتمان</span>
                <span>💳</span>
            </div>
            <div class="mt-1 font-mono font-bold text-slate-100 text-sm sm:text-base">
                @Card.CreditLimit.ToString("N0") <span class="text-[10px] font-sans text-slate-400">ج.م</span>
            </div>
        </div>

        <!-- 2. Available Credit -->
        <div class="glass-card p-3 rounded-xl border border-slate-800/90 bg-slate-900/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-400 text-[10px] uppercase font-semibold">
                <span>الرصيد المتاح</span>
                <span>✅</span>
            </div>
            <div class="mt-1 font-mono font-bold text-emerald-400 text-sm sm:text-base">
                @Card.AvailableCredit.ToString("N0") <span class="text-[10px] font-sans text-emerald-500/80">ج.م</span>
            </div>
        </div>

        <!-- 3. Current Balance / Debt -->
        <div class="glass-card p-3 rounded-xl border border-slate-800/90 bg-slate-900/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-400 text-[10px] uppercase font-semibold">
                <span>الدين غير المسدد</span>
                <span>📉</span>
            </div>
            <div class="mt-1 font-mono font-bold @(Card.TotalDebt > 0 ? "text-rose-400" : "text-slate-400") text-sm sm:text-base">
                @Card.TotalDebt.ToString("N0") <span class="text-[10px] font-sans text-slate-400">ج.م</span>
            </div>
        </div>

        <!-- 4. Settlement Day / Due Date -->
        <div class="glass-card p-3 rounded-xl border border-slate-800/90 bg-slate-900/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-400 text-[10px] uppercase font-semibold">
                <span>يوم التسوية</span>
                <span>📅</span>
            </div>
            <div class="mt-1 font-mono font-bold text-amber-300 text-sm sm:text-base flex items-center justify-between">
                <span>يوم @Card.SettlementDay</span>
                @if (Card.UtilizationPercentage > 0)
                {
                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-800/80 @(Card.UtilizationPercentage > 100 ? "text-rose-400 font-bold" : "text-slate-300")">
                        @Card.UtilizationPercentage%
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Transactions Grid Split between Purchases and Payments -->
    @if (Transactions.Count == 0)
    {
        <div class="glass-card p-10 rounded-2xl text-center text-slate-400 space-y-3">
            <div class="text-3xl">🧾</div>
            <div class="font-bold text-slate-300">لا توجد معاملات مسجلة لهذه البطاقة</div>
            <p class="text-xs text-slate-400">سجل أول عملية شراء أو سداد لهذه البطاقة بسهولة.</p>
            <div class="pt-1">
                <button @onclick="() => OnAddTransaction.InvokeAsync(Card.Id)" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl shadow-lg transition-all inline-flex items-center gap-1.5">
                    <span>➕</span> تسجيل معاملة جديدة
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <!-- Purchases -->
            <div class="glass-card rounded-2xl overflow-hidden border border-slate-800 shadow-xl">
                <div class="px-4 py-3 border-b border-slate-800 flex items-center justify-between">
                    <div>
                        <div class="text-sm font-bold text-slate-100">🛒 مشتريات</div>
                        <div class="text-xs text-slate-400">@Purchases.Count مدخل • الإجمالي: <span class="font-mono text-amber-300 font-semibold">@PurchasesTotal.ToString("N2") ج.م</span></div>
                    </div>
                </div>

                @if (Purchases.Count == 0)
                {
                    <div class="text-center py-8 text-slate-400 text-xs">لا توجد مشتريات مسجلة لهذه البطاقة.</div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-xs text-slate-300">
                            <thead class="bg-slate-900/90 text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-800">
                                <tr>
                                    <th class="p-3.5">التاريخ</th>
                                    <th class="p-3.5 text-center">المبلغ</th>
                                    <th class="p-3.5 text-right">موعد الاستحقاق</th>
                                    @if (OnDeleteTransaction.HasDelegate)
                                    {
                                        <th class="p-3.5 text-center">الإجراءات</th>
                                    }
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/80">
                                @foreach (var tx in Purchases)
                                {
                                    <tr class="hover:bg-slate-800/40 transition-colors">
                                        <td class="p-3.5 font-mono text-slate-300 text-[11px]">@tx.Date.ToString("yyyy-MM-dd")</td>
                                        <td class="p-3.5 text-center font-mono font-bold text-rose-400">-@tx.Amount.ToString("N2") ج.م</td>
                                        <td class="p-3.5 font-mono text-[11px] text-slate-400"><span>📅 @tx.SettlementDate.ToString("yyyy-MM-dd")</span></td>
                                        @if (OnDeleteTransaction.HasDelegate)
                                        {
                                            <td class="p-3.5 text-center">
                                                <div class="flex items-center justify-center gap-1.5">
                                                    <button @onclick="() => OnDeleteTransaction.InvokeAsync(tx.Id)" title="حذف المعاملة" class="p-1.5 bg-slate-800 hover:bg-rose-600 text-slate-300 hover:text-white rounded-lg transition-all text-xs">🗑️</button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Payments -->
            <div class="glass-card rounded-2xl overflow-hidden border border-slate-800 shadow-xl">
                <div class="px-4 py-3 border-b border-slate-800 flex items-center justify-between">
                    <div>
                        <div class="text-sm font-bold text-slate-100">💰 سداد</div>
                        <div class="text-xs text-slate-400">@Payments.Count مدخل • الإجمالي: <span class="font-mono text-emerald-300 font-semibold">@PaymentsTotal.ToString("N2") ج.م</span></div>
                    </div>
                </div>

                @if (Payments.Count == 0)
                {
                    <div class="text-center py-8 text-slate-400 text-xs">لا توجد عمليات سداد مسجلة لهذه البطاقة.</div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-xs text-slate-300">
                            <thead class="bg-slate-900/90 text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-800">
                                <tr>
                                    <th class="p-3.5">التاريخ</th>
                                    <th class="p-3.5 text-center">المبلغ</th>
                                    @if (OnDeleteTransaction.HasDelegate)
                                    {
                                        <th class="p-3.5 text-center">الإجراءات</th>
                                    }
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/80">
                                @foreach (var tx in Payments)
                                {
                                    <tr class="hover:bg-slate-800/40 transition-colors">
                                        <td class="p-3.5 font-mono text-slate-300 text-[11px]">@tx.Date.ToString("yyyy-MM-dd")</td>
                                        <td class="p-3.5 text-center font-mono font-bold text-emerald-400" >+@tx.Amount.ToString("N2") ج.م</td>

                                        @if (OnDeleteTransaction.HasDelegate)
                                        {
                                            <td class="p-3.5 text-center">
                                                <div class="flex items-center justify-center gap-1.5">
                                                    <button @onclick="() => OnDeleteTransaction.InvokeAsync(tx.Id)" title="حذف المعاملة" class="p-1.5 bg-slate-800 hover:bg-rose-600 text-slate-300 hover:text-white rounded-lg transition-all text-xs">🗑️</button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public CreditCardSummaryDto Card { get; set; } = new();
    [Parameter] public List<TransactionDto> Transactions { get; set; } = new();
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<Guid> OnDeleteTransaction { get; set; }
    [Parameter] public EventCallback<Guid> OnAddTransaction { get; set; }
    [Parameter] public EventCallback<CreditCardSummaryDto> OnEditCard { get; set; }

    private string? ArabicBankName => BankHelper.GetArabicName(Card.BankName);

    private List<TransactionDto> Purchases => Transactions.Where(t => t.Type == TransactionType.Purchase).OrderByDescending(t => t.Date).ToList();
    private List<TransactionDto> Payments => Transactions.Where(t => t.Type == TransactionType.Payment).OrderByDescending(t => t.Date).ToList();

    private decimal PurchasesTotal => Purchases.Sum(t => t.Amount);
    private decimal PaymentsTotal => Payments.Sum(t => t.Amount);
}
