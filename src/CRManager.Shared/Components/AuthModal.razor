@using CRManager.Shared.DTOs
@using CRManager.Shared.Services
@inject IAuthService AuthService

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-md p-4" dir="rtl">
        <div class="glass-card w-full max-w-md p-6 rounded-2xl space-y-5 border border-slate-700/80 shadow-2xl bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950">
            
            <!-- Modal Header -->
            <div class="flex justify-between items-center pb-3 border-b border-slate-800">
                <div class="flex items-center gap-2">
                    <span class="text-xl">🔐</span>
                    <h3 class="text-xl font-extrabold text-slate-100">
                        @(_isRegisterTab ? "إنشاء حساب جديد" : "تسجيل الدخول إلى CRManager")
                    </h3>
                </div>
                <button @onclick="Close" class="text-slate-400 hover:text-white text-lg">✕</button>
            </div>

            <!-- Tab Switcher -->
            <div class="flex bg-slate-950/60 p-1 rounded-xl border border-slate-800" dir="rtl">
                <button type="button" @onclick="() => SwitchTab(false)" class="flex-1 py-1.5 text-xs font-bold rounded-lg transition-all @(!_isRegisterTab ? "bg-blue-600 text-white shadow" : "text-slate-400 hover:text-slate-200")">
                    تسجيل الدخول
                </button>
                <button type="button" @onclick="() => SwitchTab(true)" class="flex-1 py-1.5 text-xs font-bold rounded-lg transition-all @(_isRegisterTab ? "bg-blue-600 text-white shadow" : "text-slate-400 hover:text-slate-200")">
                    إنشاء حساب
                </button>
            </div>

            <!-- Error Banner -->
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="p-3 bg-rose-950/80 border border-rose-800/60 rounded-xl text-rose-300 text-xs flex items-center gap-2">
                    <span>⚠️</span>
                    <span>@_errorMessage</span>
                </div>
            }

            <!-- Form -->
            <form @onsubmit="HandleSubmit" class="space-y-4 text-sm" dir="rtl">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">البريد الإلكتروني</label>
                    <input type="email" @bind="_email" class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2.5 text-slate-100 focus:outline-none focus:border-blue-500 placeholder-slate-500" placeholder="name@example.com" required />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">كلمة المرور</label>
                    <input type="password" @bind="_password" class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2.5 text-slate-100 focus:outline-none focus:border-blue-500 placeholder-slate-500" placeholder="الحد الأدنى 6 أحرف" minlength="6" required />
                </div>

                <div class="pt-2">
                    <button type="submit" disabled="@_isLoading" class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 disabled:bg-blue-800 text-white text-sm font-bold rounded-xl shadow-lg transition-all flex items-center justify-center gap-2">
                        @if (_isLoading)
                        {
                            <span class="animate-spin text-sm">⏳</span>
                            <span>جارٍ التحقق...</span>
                        }
                        else
                        {
                            <span>@(_isRegisterTab ? "تسجيل وإنشاء حساب" : "تسجيل الدخول")</span>
                        }
                    </button>
                </div>
            </form>

            <div class="text-center text-[11px] text-slate-400 pt-1">
                @if (!_isRegisterTab)
                {
                    <span>ليس لديك حساب؟ <a href="javascript:void(0)" @onclick="() => SwitchTab(true)" class="text-blue-400 font-semibold hover:underline">سجل الآن</a></span>
                }
                else
                {
                    <span>هل لديك حساب؟ <a href="javascript:void(0)" @onclick="() => SwitchTab(false)" class="text-blue-400 font-semibold hover:underline">سجل الدخول</a></span>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnAuthSuccess { get; set; }

    private bool _isRegisterTab;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private bool _isLoading;

    private void SwitchTab(bool isRegister)
    {
        _isRegisterTab = isRegister;
        _errorMessage = null;
    }

    private async Task Close()
    {
        IsOpen = false;
        _errorMessage = null;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _errorMessage = null;

        AuthResult result;
        if (_isRegisterTab)
        {
            result = await AuthService.RegisterAsync(_email.Trim(), _password);
        }
        else
        {
            result = await AuthService.LoginAsync(_email.Trim(), _password);
        }

        _isLoading = false;

        if (result.Succeeded)
        {
            await OnAuthSuccess.InvokeAsync();
            await Close();
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "فشل التحقق. يرجى التحقق من بياناتك.";
        }
    }
}
